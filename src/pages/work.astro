---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const work = await getCollection('work');

const roles = work
	.filter((entry) => entry.data.type === 'role')
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const projects = work
	.filter((entry) => entry.data.type === 'project')
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
	title="Before Data | Micaela Lafratta"
	description="Learn about Micaela Lafratta's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Before Data"
				tagline="See my most relevant roles and projects below to get an idea of my past experience."
				align="start"
			/>
			<h3>Roles</h3>
			<Grid variant="offset">
				{
					roles.map((role) => (
						<li>
							<PortfolioPreview project={role} />
						</li>
					))
				}
			</Grid>
			<h3>Projects</h3>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	/* work.astro no necesita estilos propios adicionales:
	   todos los elementos usan componentes ya estilizados con la paleta corporativa */
</style>
